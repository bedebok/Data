                                <locus from="71r" to="74v"/>
                                <title key="HOURS_VIRGIN.prime">Prime</title>
                            </msItem>
                            <msItem class="hour" n="17">
                                <locus from="74v" to="77r"/>
                                <title key="HOURS_VIRGIN.terce">Terce</title>
                            </msItem>
                            <msItem class="hour" n="18">
                                <locus from="77r" to="79v"/>
                                <title key="HOURS_VIRGIN.sext">Sext</title>
                            </msItem>
                            <msItem class="hour" n="19">
                                <locus from="80r" to="82r"/>
                                <title key="HOURS_VIRGIN.nones">Nones</title>
                            </msItem>
                            <msItem class="hour" n="20">
                                <locus from="82v" to="88r"/>
                                <title key="HOURS_VIRGIN.vespers">Vespers</title>
                            </msItem>
                            <msItem class="hour" n="21">
                                <locus from="88v" to="92r"/>
                                <title key="HOURS_VIRGIN.compline">Compline</title>
                            </msItem>
                        </msItem>
                        <msItem class="undefined" n="22">
                            <locus from="93r" to="94r"/>
                            <title>Alma Redemptoris</title>
                            <rubric>Alma rede<ex>m</ex>ptoris</rubric>
                            <incipit><hi>O</hi> du gutlike moder godes</incipit>
                            <explicit>vnsen leuen here<ex>n</ex> ih<ex>esu</ex>m
                                <ex>christu</ex>m</explicit>
                        </msItem>
                        <msItem class="undefined" n="23">
                            <locus from="94r" to="94v"/>
                            <title>Ave Regina Cœlorum</title>
                            <msItem class="collect" n="24">
                                <locus from="94v" to="94v"/>
                                <title>Famulorum tuorum</title>
                            </msItem>
                            <msItem class="antiphon" n="25">
                                <locus from="94v" to="95r"/>
                                <title>Speciosa facta es</title>
                            </msItem>
                        </msItem>
                        <msItem class="undefined" n="26">
                            <locus from="95r" to="95r"/>
                            <title>O florens</title>
                        </msItem>
                        <msItem class="undefined" n="27">
                            <locus from="95r" to="95v"/>
                            <title>Ave stella matutina</title>
                        </msItem>
                        <msItem class="undefined" n="28">
                            <locus from="95v" to="96r"/>
                            <title>Salve mundi domina</title>
                        </msItem>
                        <msItem class="undefined" n="29">
                            <locus from="96r" to="96v"/>
                            <title>De te virgo</title>
                        </msItem>
                        <msItem class="undefined" n="30">
                            <locus from="96v" to="97r"/>
                            <title>Deus qui de beatae Mariae</title>
                        </msItem>
                        <msItem class="antiphon" n="31">
                            <locus from="97r" to="97v"/>
                            <title>Gaudendum nobis est</title>
                        </msItem>
                        <msItem class="collect" n="32">
                            <locus from="97v" to="99r"/>
                            <title/>
                        </msItem>
                        <msItem class="psalms" n="33">
                            <locus from="98r" to="98r"/>
                            <title>Psalms 113, 117, 118</title>
                            <incipit>Herrens tienere loffuer hanom</incipit>
                            <explicit>Las Pesßenn Egen Haandt</explicit>
                            <textLang mainLang="da"/>
                        </msItem>
                        <msItem class="miniature" n="34">
                            <locus from="98v" to="98v"/>
                            <title>[Anna selbdritt]</title>
                        </msItem>
                        <msItem class="cycle" n="35">
                            <locus from="99r" to="109r"/>
                            <title key="HOURS_ANNE">Hours of St. Anne</title>
                            <rubric>van S. Annen</rubric>
                            <incipit><hi>G</hi>ot denke an myne hulpe</incipit>
                            <explicit>Ih<ex>esus</ex>
                                <ex>christus</ex> godes sone. Amen</explicit>
                            <textLang mainLang="gml"/>
                        </msItem>
                        <msItem class="cycle" n="36">
                            <locus from="109r" to="130r"/>
                            <title key="HOURS_TRINITY">Hours of the Trinity</title>
                            <rubric>De hilge dreualdigheit</rubric>
                            <incipit><hi>O</hi> Hilge dreualdicheit wy an ropen dy</incipit>
                            <explicit>dat ik van dy begherende byn Amen</explicit>
                            <textLang mainLang="gml"/>
                        </msItem>
                        <msItem class="cycle" n="37">
                            <locus from="130r" to="165v"/>
                            <title key="HOURS_PASSION">Hours of the Passion</title>
                            <rubric>Hir beghinnen sik de tide van deme lydende godes</rubric>
                            <incipit><hi>W</hi>y anbeden dy cristus</incipit>
                            <explicit>myt bernender beghericheit beholden. Amen.</explicit>
                            <textLang mainLang="gml"/>
                            <msItem class="credo" n="38">
                                <locus from="136v" to="137r"/>
                                <title key="CREDO">Credo</title>
                            </msItem>
                        </msItem>
                        <msItem class="prayer" n="39">
                            <locus from="165v" to="166r"/>
                            <title/>
                            <rubric>En ghut becht na deme lydende to losende.</rubric>
                            <incipit><hi>I</hi>k bidde dy leue here</incipit>
                            <explicit>alle dyner leuen hilghen. Amen.</explicit>
                            <textLang mainLang="gml"/>
                        </msItem>
                        <msItem class="cycle" n="40">
                            <locus from="166v" to="198v"/>
                            <title key="HOURS_SPIRIT">Hours of the Holy Spirit</title>
                            <rubric>Hir begynne<ex>n</ex> de tide va<ex>n</ex> deme hilgen
                                gheiste.</rubric>
                            <incipit><hi>D</hi>e vader vnd<ex>e</ex> de sone</incipit>
                            <explicit/>
                            <msItem class="miniature" n="41">
                                <locus from="167r" to="167r"/>
                                <title>[Pentecost]</title>
                            </msItem>
                            <msItem class="undefined" n="42">
                                <locus from="167v" to="167v"/>
                                <title/>
                                <incipit>Wi Christiann</incipit>
                                <explicit/>
                                <textLang mainLang="da"/>
                            </msItem>
                            <msItem class="prayer" n="43">
                                <locus from="173r" to="173r"/>
                                <title key="VENI_SANCTE_SPIRITUS">Veni Sancte Spiritus</title>
                                <incipit><hi>U</hi>eni sancte sp<ex>irit</ex>us</incipit>
                                <explicit>regnas in s<ex>e</ex>c<ex>u</ex>la
                                        s<ex>e</ex>c<ex>u</ex>lor<ex>um</ex>
                                    am<ex>en</ex>.</explicit>
                                <textLang mainLang="lat"/>
                            </msItem>
                            <msItem class="miniature" n="44">
                                <locus from="199v" to="199v"/>
                                <title>[Purgatory]</title>
                            </msItem>
                        </msItem>
                        <msItem class="cycle" n="45">
                            <locus from="200v" to="227r"/>
                            <title key="OFFICE_DEAD">Office of the Dead</title>
                            <rubric>Vigilie</rubric>
                            <incipit><hi>G</hi>od here nym der cristenheyt bet vor alle cristene
                                sele</incipit>
                            <explicit/>
                            <textLang mainLang="gml"/>
                        </msItem>
                        <msItem class="prayer" n="46">
                            <locus from="228r" to="230r"/>
                            <title key="AODORO_TE">Adoro Te</title>
                            <incipit>Here ih<ex>es</ex>u criste ick anbede dy hangende</incipit>
                            <explicit>Ik bidde dy vor barme dy wnser Am<ex>en</ex></explicit>
                            <textLang mainLang="gml"/>
                            <msItem class="indulgence" n="47">
                                <locus from="230r" to="230r"/>
                                <title/>
                                <incipit>De hillige gheyslike vad<ex>er</ex> de pawes
                                        sixt<ex>us</ex> de verde</incipit>
                                <explicit>thosamede is xl m iar xlc iar vn<ex>de</ex> xlc
                                    daghe</explicit>
                                <textLang mainLang="gml"/>
                            </msItem>
                        </msItem>
                        <msItem class="prayer" n="48">
                            <locus from="230r" to="230r"/>
                            <title>A prayer to Jesus Christ</title>
                            <incipit>O here ih<ex>es</ex>u <ex>christ</ex>e ik anbede dy tho
                                    kome<ex>n</ex>de</incipit>
                            <explicit>ame<ex>n</ex> p<ex>ate</ex>r n<ex>oste</ex>r Aue
                                maria</explicit>
                            <textLang mainLang="gml"/>
                        </msItem>
                        <msItem class="miniature" n="49">
                            <locus from="230v" to="230v"/>
                            <title>[Archangel Michael]</title>
                        </msItem>
                        <msItem class="cycle" n="50">
                            <locus from="231r" to="270v"/>
                            <title key="OFFICE_DEAD">Office of the Dead</title>
                            <incipit type="latin"><hi>D</hi>Ilexi quoniam ex audiet
                                dominus:</incipit>
                            <incipit><hi>I</hi>k hebbe de gude myt leue des here wt
                                erkoren</incipit>
                            <explicit><hi>A</hi>alle louigen selen laeth milde got vmme dyne
                                barmeherticheit yn dynen vrede rouwen. Amen.</explicit>
                            <textLang mainLang="gml"/>
                            <msItem class="prayer" n="51">
                                <locus from="237v" to="238v"/>
                                <title key="MAGNIFICAT">Magnificat</title>
                            </msItem>
                        </msItem>
                        <msItem class="absolution" n="52">
                            <locus from="271r" to="271v"/>
                            <title/>
                            <rubric>FForma plenissi<ex>m</ex>e absoluc<ex>i</ex>o<ex>n</ex>is
                                    <ex>et</ex> remissionis i<ex>nter</ex> vita</rubric>
                            <incipit>misereat<ex>ur</ex> tui
                                <hi>D</hi><ex>omi</ex>n<ex>u</ex>s</incipit>
                            <explicit>in no<ex>m</ex>i<ex>n</ex>e p<ex>at</ex>ris <ex>et</ex> filij
                                    <ex>et</ex> sp<ex>irit</ex>us s<ex>an</ex>c<ex>t</ex>i
                                Amen</explicit>
                            <textLang mainLang="lat"/>
                        </msItem>
                        <msItem class="absolution" n="53">
                            <locus from="272r" to="272r"/>
                            <title/>
                            <incipit>D<ex>omin</ex>us nost<ex>er</ex> ihe<ex>sus</ex>
                                <ex>christus</ex></incipit>
                            <explicit>In no<ex>m</ex>i<ex>n</ex>e p<ex>at</ex>r<ex>is</ex> et
                                filij</explicit>
                        </msItem>
                        <msItem class="cycle" n="54">
                            <locus from="273r" to="287v"/>
                            <title key="OFFICE_DEAD.lessons">Lessons from the Office of the
                                Dead</title>
                            <rubric>l<ex>e</ex>cc<ex>i</ex>o prima</rubric>
                            <incipit><hi>A</hi>ch here schone my vnder dynen geyslen</incipit>
                            <explicit>In deme greseliken da <ex>/defective/</ex></explicit>
                            <textLang mainLang="gml"/>
                        </msItem>
