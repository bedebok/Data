                    <head> A fifteenth-century prayer book in Low German with many full-page
                        miniatures. It contains added prayers in Danish. </head>
                    <msContents>
                        <msItem class="miniature" n="1">
                            <locus from="1v" to="1v"/>
                            <title>[Mary at reading]</title>
                        </msItem>
                        <msItem class="calendar" n="2">
                            <locus from="2r" to="11v"/>
                            <title>Calendar</title>
                            <textLang mainLang="gml"/>
                        </msItem>
                        <msItem class="prayer" n="3">
                            <locus from="11v" to="11v"/>
                            <title>Added prayer in Danish</title>
                            <incipit>Gudtz Guodhied will wi prise</incipit>
                            <explicit>est Anima mea</explicit>
                            <textLang mainLang="da" otherLangs="lat"/>
                        </msItem>
                        <msItem class="computus" n="4">
                            <locus from="12r" to="12r"/>
                            <title>Computus table</title>
                        </msItem>
                        <msItem class="prognosticon" n="5">
                            <locus from="12v" to="12v"/>
                            <title>Prognosticon</title>
                            <incipit>Første dagh i ny manæ</incipit>
                            <explicit>gør me<ex>n</ex>isken let...</explicit>
                            <textLang mainLang="da"/>
                        </msItem>
                        <msItem class="cycle" n="6">
                            <locus from="13r" to="37v"/>
                            <title key="PENITENTIAL_PSALMS">Seven Penitential Psalms</title>
                            <rubric>Hir begynne<ex>n</ex> soue<ex>n</ex> salme<ex>n</ex></rubric>
                            <incipit type="latin"><hi>D</hi>omine ne in furo<ex>r</ex>e tuo arguas
                                me: de q<ex>uod</ex> in</incipit>
                            <incipit><hi>H</hi>ere en schelt my nicht in dyneme vmmode</incipit>
                            <explicit>dar ynny sy de wonunghe der sachtmodicheit vn<ex>de</ex> des
                                vredes. Amen.</explicit>
                            <textLang mainLang="gml" otherLangs="lat"/>
                            <msItem class="litany" n="7">
                                <locus from="24r" to="37v"/>
                                <title key="LITANY_SAINTS">Litany of the Saints</title>
                            </msItem>
                            <msItem class="litany" n="8">
                                <locus from="37v" to="42v"/>
                                <title key="LITANY_MARY">Litany of Mary</title>
                                <rubric>Vnser leue<ex>n</ex> vrowe<ex>n</ex>
                                    letanni<ex>e</ex></rubric>
                                <incipit><hi>K</hi>yrie<ex>leyson</ex></incipit>
                                <explicit>dynes leue<ex>n</ex> kindes milden barmherticheit.
                                    amen.</explicit>
                                <textLang mainLang="gml"/>
                            </msItem>
                        </msItem>
                        <msItem class="miniature" n="9">
                            <locus from="43v" to="43v"/>
                            <title>[Crowned Madonna]</title>
                        </msItem>
                        <msItem class="cycle" n="10">
                            <locus from="44r" to="92v"/>
                            <title key="HOURS_VIRGIN">Hours of the Virgin</title>
                            <incipit type="latin"><hi>D</hi>omine labia mea aperies. Et os
                                    meu<ex>m</ex> annu<ex>n</ex>ciabit laudem tuo</incipit>
                            <incipit><hi>H</hi>ere openen myne lippen</incipit>
                            <explicit>O barmhertige. O milde. O sote maria. <ex>et
                                cetera</ex></explicit>
                            <textLang mainLang="gml"/>
                            <msItem class="hour" n="11">
                                <locus from="44r" to="54v"/>
                                <title key="HOURS_VIRGIN.matins">Matins</title>
                            </msItem>
                            <msItem class="hour" n="12">
                                <locus from="54v" to="71r"/>
                                <title key="HOURS_VIRGIN.lauds">Lauds</title>
                                <msItem class="prayer" n="13">
                                    <locus from="55r" to="57r"/>
                                    <title key="TE_DEUM">Te Deum</title>
                                </msItem>
                                <msItem class="prayer" n="14">
                                    <locus from="67r" to="67v"/>
                                    <title>O Gloriosa Domina</title>
                                    <rubric>O gloriosa domina</rubric>
                                    <incipit><hi>O</hi> aller hogiste vrowe up ge hoghet bouen alle
                                        hemele</incipit>
                                    <explicit>lose vns ewyliken benedyde
                                        iu<ex>n</ex>curowen</explicit>
                                    <textLang mainLang="gml"/>
                                </msItem>
                                <msItem class="miniature" n="15">
                                    <locus from="68v" to="68v"/>
                                    <title>[John the Baptist]</title>
                                </msItem>
                            </msItem>
